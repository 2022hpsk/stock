# 复制为 .env 后填写。.env 已被 .gitignore 忽略，严禁提交真实密钥（开发规范 R7）。

# ---------- 行情数据源 ----------
# Tushare Pro（可选，配置后作为主源；未配置则使用 AkShare）
TUSHARE_TOKEN=

# ---------- 情报数据源 ----------
# 金十数据开放平台 https://open.jin10.com/ （可选，需申请授权）
JIN10_API_KEY=
JIN10_API_SECRET=

# ---------- 情报外置导入 HTTP 接收端 ----------
# quantstock intel serve 的鉴权 token（自行生成随机串）
INTEL_INGEST_TOKEN=
INTEL_INGEST_HOST=127.0.0.1
INTEL_INGEST_PORT=8787

# ---------- LLM（可选，仅用于情报摘要与兜底分类，不参与下单决策，见 I-R3）----------
ANTHROPIC_API_KEY=
QUANTSTOCK_LLM_MODEL=claude-sonnet-5

# ---------- 通知渠道 ----------
NOTIFY_EMAIL_HOST=
NOTIFY_EMAIL_PORT=465
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_TO=
WECOM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 券商通道（M5 阶段）----------
# miniQMT 客户端本地路径与资金账号；真实账号不要写入任何入库文件
XTQUANT_USERDATA_PATH=
XTQUANT_ACCOUNT_ID=

# ---------- 运行环境 ----------
QUANTSTOCK_ENV=dev          # dev / prod
QUANTSTOCK_LOG_LEVEL=INFO
QUANTSTOCK_VAR_DIR=./var
# 交易通道：paper（默认）/ manual / xtquant。切到 xtquant 需同时显式加 --live
QUANTSTOCK_BROKER=paper
